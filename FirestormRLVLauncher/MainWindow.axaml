<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FirestormRLVLauncher"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="FirestormRLVLauncher.MainWindow"
        Title="FirestormRLVLauncher v1.5"
        Width="600"
        Height="400">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="200, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="8" ColumnSpacing="4">
            <StackPanel>
                <Border Grid.Column="0" BorderThickness="1" BorderBrush="#FFAAAAAA" Padding="4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Loaded Login" FontWeight="Bold" FontSize="14"/>

                        <TextBlock Name="LoginName"
                                   Text=""/>
                        <TextBlock Name="TimeText"
                                   Text="Time [h]:"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="LockButton"
                                    Content="Lock"
                                    Width="56"
                                    Click="LockButton_Click"
                                    />
                            <Button Name="EditButton"
                                    Content="Edit"
                                    Click="EditButton_Click"
                                    Width="56"
                                    />
                        </StackPanel>
                        <Button Name="LaunchButton"
                                Click="LaunchButton_Click"
                                Content="Login"
                                Height="50" Width="120"
                                Background="Orange"
                                VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <Border BorderThickness="1" BorderBrush="#FFAAAAAA" Padding="4">
                    <StackPanel VerticalAlignment="Top" Spacing="8">
                        <TextBlock Text="Current File" FontWeight="Bold" FontSize="14"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="File: "/>
                            <TextBlock Name="CurrentFile" Text="None"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="LoadProfileButton" 
                                    Content="Load"
                                    Click="LoadLogin_Click"/>
                            <Button Name="CreateProfileButton"
                                    Click="CreateProfile_Click"
                                    Content="Create"/>
                            <Button Name="OpenFolderButton"
                                    Click="OpenFolder_Click"
                                    Content="Open folder"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" BorderBrush="#FFAAAAAA" Padding="4">
                    <StackPanel VerticalAlignment="Top" Spacing="8">
                        <TextBlock Text="Firestorm Executable" FontWeight="Bold" FontSize="14"/>
                        <Grid ColumnDefinitions="*, 50">
                            <TextBlock Grid.Column="0" Name="FirestormExeText"
                                   Text="C:\Program Files\Firestorm-Releasex64\Firestorm-Releasex64.exe"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"/>
                            <Button Grid.Column="1" Name="EditExe"
                                    Click="EditExe_Click"
                                    Content=".."
                                    Width="30"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#FFAAAAAA" Margin="8">
                <ListBox Name="StatusList" 
                         HorizontalAlignment="Stretch"
                         >
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:StatusMessage">
                            <TextBlock Text="{Binding Message}" Foreground="{Binding Color}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="CopyStatusMessage_Click"/>
                            <MenuItem Header="Copy All" Click="CopyAllStatusMessage_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.Styles> 
                        <Style Selector="ListBoxItem"> <Setter Property="Padding" Value="1" /> </Style> 
                    </ListBox.Styles>
                </ListBox>
        </Border>
    </Grid>
</Window>
